{
  "name": "kassza-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "predev": "npm run kassza:install",
    "dev": "npm run sandbox:build && next dev",
    "dev:next": "next dev",
    "prebuild": "npm run kassza:install",
    "build": "npm run sandbox:build && next build",
    "start": "next start",
    "sandbox:build": "node scripts/build-sandbox.mjs",
    "pretypecheck": "npm run kassza:install",
    "typecheck": "npm run sandbox:build && next typegen && tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "pretest": "npm run kassza:install",
    "test": "vitest run",
    "ci": "npm run lint && npm run typecheck && npm run test && npm run build",
    "kassza:install": "node scripts/install-kassza.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@monaco-editor/react": "4.7.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.1.0",
    "clsx": "^2.1.1",
    "fumadocs-core": "16.18.4",
    "fumadocs-mdx": "15.5.3",
    "fumadocs-twoslash": "4.0.4",
    "fumadocs-ui": "16.18.4",
    "lenis": "1.3.27",
    "lucide-react": "^1.64.0",
    "lz-string": "1.5.0",
    "monaco-editor": "^0.57.0",
    "motion": "14.12.0",
    "next": "^16.4.6",
    "next-themes": "0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "shiki": "4.6.0",
    "sucrase": "3.35.1",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@tailwindcss/postcss": "4.3.5",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.2.7",
    "esbuild": "^0.28.2",
    "postcss": "^8.5.32",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "dompurify": "3.4.17"
  }
}
